    FE6[Radix UI · Sonner · i18n]
  end

  subgraph BE["Backend · localhost:3001"]
    direction TB
    BE1["ICON_NODE_NESTJS"]
    BE2["ICON_NODE_NODEJS"]
    BE3[Mongoose · class-validator]
    BE4[Swagger / OpenAPI 3.0]
    BE5[Bee Cron mirror sync]
  end

  subgraph DATA["Data layer"]
    direction TB
    DB1["ICON_NODE_MONGODB"]
    DB2[AnimeMeta · AnimeEntry]
    DB3[AnimeMirror · BeeState · ApiMapping]
  end

  subgraph EXT["External data sources"]
    direction LR
    EX1["ICON_NODE_JIKAN"]
    EX2["ICON_NODE_BANGUMI"]
