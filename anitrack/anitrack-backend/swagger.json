{
  "openapi": "3.0.3",
  "info": {
    "title": "Anitrack API",
    "version": "0.1.0",
    "description": "Watchlist CRUD and statistics for Anitrack (Web Technologies I). JSON request/response bodies use `application/json`. Error envelope: `{ \"error\": { \"code\", \"message\", \"details\" } }`."
  },
  "tags": [
    { "name": "Anime", "description": "Watchlist entries (MongoDB-backed)" },
    { "name": "Statistics", "description": "Aggregated analytics (heatmap contract; implementation in phase 2)" },
    { "name": "Bee", "description": "Intelligent mirroring (Jikan → AnimeMirror)" },
    { "name": "AnimeMeta", "description": "Metadata cache, search, timetable, seasonal picks" }
  ],
  "paths": {
    "/api/anime": {
      "get": {
        "tags": ["Anime"],
        "summary": "List anime entries",
        "description": "Paginated list with optional `status` filter. Sorting is applied on `updatedAt` only; `sort` uses `field:direction` (direction `asc` or `desc`, default `updatedAt:desc`).",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/AnimeStatus" },
            "description": "Filter by watchlist status."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 },
            "description": "1-based page index."
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
            "description": "Page size (capped at 100)."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "updatedAt:desc", "example": "updatedAt:desc" },
            "description": "Sort key and order, e.g. `updatedAt:desc` or `updatedAt:asc`. Current implementation always sorts by `updatedAt`."
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated watchlist items.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnimeListPage" }
              }
            }
          },
          "400": {
            "description": "Invalid query (e.g. unknown `status`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorBody" },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Invalid query",
                    "details": [{ "path": "status", "reason": "Invalid enum value" }]
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorBody" } } }
          }
        }
      },
      "post": {
        "tags": ["Anime"],
        "summary": "Create anime entry",
        "description": "Creates a watchlist row. `malId` must be unique (duplicate → 409). `completedAt` / `completedDates` are only allowed when `status` is `COMPLETED`; otherwise the API returns 400. When `status` is `COMPLETED`, `completedAt` defaults to today (UTC date `YYYY-MM-DD`) and is merged into `completedDates`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AnimeEntryCreate" },
              "examples": {
                "planned": {
                  "summary": "New entry (planned)",
                  "value": {
                    "malId": 5114,
                    "status": "PLANNED"
                  }
                },
                "completed": {
                  "summary": "Completed with dates",
                  "value": {
                    "malId": 5114,
                    "status": "COMPLETED",
                    "rating": 10,
                    "completedAt": "2026-04-12",
                    "completedDates": ["2026-04-12"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created entry.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnimeEntry" }
              }
            }
          },
          "400": {
            "description": "Validation error (Zod) or business rule (completed fields without COMPLETED).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorBody" } } }
          },
          "409": {
            "description": "Duplicate `malId` (unique index).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorBody" },
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "malId already exists",
                    "details": [{ "path": "malId", "reason": "Duplicate value" }]
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorBody" } } }
          }
        }
      }
    },
    "/api/anime/{id}": {
      "get": {
        "tags": ["Anime"],
        "summary": "Get anime entry by id",
        "parameters": [{ "$ref": "#/components/parameters/EntryId" }],
        "responses": {
          "200": {
            "description": "Entry document.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnimeEntry" } } }
          },
          "404": {
            "description": "Not found or invalid ObjectId (invalid id is treated as not found for GET).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorBody" } } }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorBody" } } }
          }
        }
      },
      "patch": {
        "tags": ["Anime"],
        "summary": "Partially update anime entry",
        "description": "Partial update. When `status` changes, the server validates allowed transitions (see **409**). `completedAt` / `completedDates` may only be sent when the resulting `status` is `COMPLETED` (including unchanged COMPLETED); otherwise 400. Leaving `COMPLETED` for another status clears completion fields. Raw JSON must include keys to touch completion fields (defaults from the parser alone do not count as intent).",
        "parameters": [{ "$ref": "#/components/parameters/EntryId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AnimeEntryPatch" },
              "example": { "status": "COMPLETED", "rating": 10, "completedAt": "2026-04-20" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated entry.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnimeEntry" } } }
          },
          "400": {
            "description": "Validation error or invalid use of completion fields for non-COMPLETED status.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorBody" } } }
          },
          "404": {
            "description": "Entry not found.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorBody" } } }
          },
          "409": {
            "description": "**State machine / invalid status transition.** Returned when `status` in the body requests a transition that is not allowed from the document's current `status`. Error code is always `INVALID_STATUS_TRANSITION`.\n\nAllowed edges (implemented): `PLANNED` → `WATCHING`, `ON_HOLD`, `DROPPED`, `COMPLETED`; `WATCHING` → `ON_HOLD`, `DROPPED`, `COMPLETED`; `ON_HOLD` → `WATCHING`, `DROPPED`, `COMPLETED`; `DROPPED` → `PLANNED` only (not directly to `WATCHING`); `COMPLETED` → `WATCHING` (re-watch). Any other change of `status` yields **409** with a human-readable `message` and `details[0].reason`.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorBody" },
                "example": {
                  "error": {
                    "code": "INVALID_STATUS_TRANSITION",
                    "message": "Invalid status transition: DROPPED -> WATCHING",
                    "details": [{ "path": "status", "reason": "Invalid status transition: DROPPED -> WATCHING" }]
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorBody" } } }
          }
        }
      },
      "delete": {
        "tags": ["Anime"],
        "summary": "Delete anime entry",
        "parameters": [{ "$ref": "#/components/parameters/EntryId" }],
        "responses": {
          "204": { "description": "Deleted or id not found (invalid ObjectId also yields 204)." },
          "500": {
            "description": "Unexpected server error.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorBody" } } }
          }
        }
      }
    },
    "/api/stats/heatmap": {
      "get": {
        "tags": ["Statistics"],
        "summary": "Life-month heatmap (monthly grid)",
        "description": "Aggregates watchlist activity into **monthly** cells (\"人生纸格\"). Each cell represents one calendar month and contains `addedCount`, `completedCount`, `episodeCount`, plus `intensity` (0–4) derived from the monthly activity weight.",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/MonthYYYYMM" },
            "description": "Start month (inclusive). Format: `YYYY-MM`. Default: last 12 months."
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/MonthYYYYMM" },
            "description": "End month (inclusive). Format: `YYYY-MM`. Default: current month."
          },
          {
            "name": "tz",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "Europe/Berlin" },
            "description": "IANA timezone identifier (validated). Current monthly bucketing uses UTC months."
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly grid for the requested range.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LifeMonthHeatmapResponse" },
                "example": {
                  "start": "2005-05",
                  "end": "2006-04",
                  "months": [
                    {
                      "month": "2005-05",
                      "addedCount": 5,
                      "completedCount": 2,
                      "episodeCount": 48,
                      "intensity": 3
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/bee/status": {
      "get": {
        "tags": ["Bee"],
        "summary": "Bee mirror progress snapshot",
        "description": "Returns tier counters and optional backoff metadata. Used by dashboard dev tooling and contract smoke (GET).",
        "responses": {
          "200": {
            "description": "Progress snapshot JSON.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BeeProgressSnapshot" }
              }
            }
          }
        }
      }
    },
    "/api/bee/bangumi-mapping": {
      "get": {
        "tags": ["Bee"],
        "summary": "Bangumi ↔ MAL mapping snapshot (counts)",
        "responses": {
          "200": {
            "description": "Mongo-backed mapping counts for debugging.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BeeProgressSnapshot" }
              }
            }
          }
        }
      }
    },
    "/api/anime-meta/seasonal-random": {
      "get": {
        "tags": ["AnimeMeta"],
        "summary": "Random seasonal picks from AnimeMirror",
        "description": "Samples `tier=seasonal` mirrors with `data`; does not call Jikan on this path.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 12, "default": 4 },
            "description": "Number of cards to return (capped 1–12)."
          }
        ],
        "responses": {
          "200": {
            "description": "Wrapped list of `AnimeMeta`-shaped items.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SeasonalRandomResponse" }
              }
            }
          }
        }
      }
    },
    "/api/anime-meta/timetable": {
      "get": {
        "tags": ["AnimeMeta"],
        "summary": "7/14-day seasonal timetable (Europe/Berlin)",
        "description": "Columns are Berlin calendar days; items from mapped seasonal mirrors.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 14, "default": 7 },
            "description": "Horizon in days (clamped 1–14)."
          }
        ],
        "responses": {
          "200": {
            "description": "Timezone plus per-day columns with timetable cards.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TimetableResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "EntryId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "example": "65f0c1a2b3c4d5e6f7a8b9c0" },
        "description": "MongoDB ObjectId string."
      }
    },
    "schemas": {
      "AnimeStatus": {
        "type": "string",
        "enum": ["PLANNED", "WATCHING", "ON_HOLD", "DROPPED", "COMPLETED"]
      },
      "DateYYYYMMDD": {
        "type": "string",
        "format": "date",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Calendar date `YYYY-MM-DD`."
      },
      "MonthYYYYMM": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}$",
        "description": "Calendar month `YYYY-MM`."
      },
      "ApiErrorDetail": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        }
      },
      "ApiErrorBody": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "details"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "NOT_FOUND",
                  "INVALID_STATUS_TRANSITION",
                  "UPSTREAM_ERROR",
                  "INTERNAL_ERROR"
                ]
              },
              "message": { "type": "string" },
              "details": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/ApiErrorDetail" }
              }
            }
          }
        }
      },
      "BeeProgressSnapshot": {
        "type": "object",
        "description": "Loose JSON snapshot for Bee progress or mapping counts (fields evolve with implementation).",
        "additionalProperties": true
      },
      "SeasonalRandomResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AnimeMeta" }
          }
        }
      },
      "TimetableDayColumn": {
        "type": "object",
        "required": ["date", "dateLabel", "weekdayLabel", "items"],
        "properties": {
          "date": { "type": "string", "description": "Berlin calendar date YYYY-MM-DD." },
          "dateLabel": { "type": "string" },
          "weekdayLabel": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          }
        }
      },
      "TimetableResponse": {
        "type": "object",
        "required": ["timezone", "days"],
        "properties": {
          "timezone": { "type": "string", "example": "Europe/Berlin" },
          "days": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TimetableDayColumn" }
          }
        }
      },
      "AnimeEntry": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "malId",
          "status",
          "completedDates",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "description": "Stringified MongoDB `_id`." },
          "userId": { "type": "string", "description": "Temporary owner identifier (phase 3 placeholder)." },
          "malId": { "type": "integer", "minimum": 0 },
          "status": { "$ref": "#/components/schemas/AnimeStatus" },
          "rating": { "type": "integer", "minimum": 0, "maximum": 10 },
          "episodesWatched": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" },
          "startedAt": { "$ref": "#/components/schemas/DateYYYYMMDD" },
          "completedAt": { "$ref": "#/components/schemas/DateYYYYMMDD" },
          "completedDates": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DateYYYYMMDD" }
          },
          "animeMeta": { "$ref": "#/components/schemas/AnimeMeta" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AnimeMeta": {
        "type": "object",
        "required": ["malId", "title"],
        "properties": {
          "id": { "type": "string" },
          "malId": { "type": "integer", "minimum": 0 },
          "title": { "type": "string" },
          "imageUrl": { "type": "string", "format": "uri" },
          "episodes": { "type": "integer", "minimum": 0 },
          "totalEpisodes": { "type": "integer", "minimum": 0 },
          "score": { "type": "number", "minimum": 0, "maximum": 10 },
          "synopsis": { "type": "string" },
          "genres": { "type": "array", "items": { "type": "string" } }
        }
      },
      "AnimeEntryCreate": {
        "type": "object",
        "required": ["malId"],
        "properties": {
          "malId": { "type": "integer", "minimum": 0 },
          "status": { "$ref": "#/components/schemas/AnimeStatus", "default": "PLANNED" },
          "rating": { "type": "integer", "minimum": 0, "maximum": 10 },
          "episodesWatched": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string", "maxLength": 5000 },
          "startedAt": { "$ref": "#/components/schemas/DateYYYYMMDD" },
          "completedAt": { "$ref": "#/components/schemas/DateYYYYMMDD" },
          "completedDates": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DateYYYYMMDD" },
            "default": []
          }
        }
      },
      "AnimeEntryPatch": {
        "type": "object",
        "description": "All fields optional (partial update). Same field constraints as create where applicable.",
        "properties": {
          "malId": { "type": "integer", "minimum": 0 },
          "status": { "$ref": "#/components/schemas/AnimeStatus" },
          "rating": { "type": "integer", "minimum": 0, "maximum": 10 },
          "episodesWatched": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string", "maxLength": 5000 },
          "startedAt": { "$ref": "#/components/schemas/DateYYYYMMDD" },
          "completedAt": { "$ref": "#/components/schemas/DateYYYYMMDD" },
          "completedDates": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DateYYYYMMDD" }
          }
        }
      },
      "AnimeListPage": {
        "type": "object",
        "required": ["items", "page", "pageSize", "total", "totalPages"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AnimeEntry" }
          },
          "page": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "minimum": 1 },
          "total": { "type": "integer", "minimum": 0 },
          "totalPages": { "type": "integer", "minimum": 1 }
        }
      },
      "LifeMonthCell": {
        "type": "object",
        "required": ["month", "addedCount", "completedCount", "episodeCount", "intensity"],
        "properties": {
          "month": { "$ref": "#/components/schemas/MonthYYYYMM" },
          "addedCount": { "type": "integer", "minimum": 0 },
          "completedCount": { "type": "integer", "minimum": 0 },
          "episodeCount": { "type": "integer", "minimum": 0 },
          "intensity": { "type": "integer", "minimum": 0, "maximum": 4 }
        }
      },
      "LifeMonthHeatmapResponse": {
        "type": "object",
        "required": ["start", "end", "months"],
        "properties": {
          "start": { "$ref": "#/components/schemas/MonthYYYYMM" },
          "end": { "$ref": "#/components/schemas/MonthYYYYMM" },
          "months": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LifeMonthCell" }
          }
        },
        "description": "Monthly heatmap response for the requested month range (inclusive)."
      }
    }
  }
}
