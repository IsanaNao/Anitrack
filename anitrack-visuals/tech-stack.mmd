flowchart TB
  TITLE[Anitrack — Technology Stack]

  subgraph FE["Frontend · localhost:3000"]
    direction TB
    FE1["ICON_NODE_NEXTJS"]
    FE2["ICON_NODE_REACT"]
    FE3["ICON_NODE_TYPESCRIPT"]
    FE4["ICON_NODE_TAILWIND"]
